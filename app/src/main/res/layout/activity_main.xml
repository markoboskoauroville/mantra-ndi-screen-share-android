<?xml version="1.0" encoding="utf-8"?>
<!--
  One screen, and every control on it from the first frame.

  design-language.md §1: nothing appears and nothing disappears. The codec and
  the quality chips are meaningless in full NDI, so in full NDI they are dimmed
  and cannot be pressed — they do not leave, because a row that leaves takes the
  rows under it up the screen with it.

  The way out is the X at the RIGHT-HAND END of the top row, and it is the only
  thing that ever sits there.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_black"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- ── the top row: title, and the way out at its right-hand end ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NDI SCREEN SHARE"
                android:textColor="@color/sand"
                android:textSize="16sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:textColor="@color/sand_dim"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/sand"
                android:textSize="20sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- ── the source name ────────────────────────────────────────── -->
        <TextView style="@style/RowLabel" android:text="Source name" />

        <EditText
            android:id="@+id/sourceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/panel"
            android:padding="12dp"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/sand"
            android:textColorHint="@color/sand_dim"
            android:hint="Pixel 7 Screen"
            android:fontFamily="monospace"
            android:textSize="15sp"
            android:autofillHints="" />

        <!-- ── the mode: exactly one in force, so a radio (§6) ────────── -->
        <TextView style="@style/RowLabel" android:text="How it goes out" />

        <RadioGroup
            android:id="@+id/mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeCompressed"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="Compressed NDI" />

            <RadioButton
                android:id="@+id/modeFull"
                style="@style/Chip"
                android:text="Full NDI" />
        </RadioGroup>

        <TextView
            android:id="@+id/modeNote"
            style="@style/Readout"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:textColor="@color/sand_dim"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <!-- ── codec: compressed only, dimmed rather than removed ─────── -->
        <TextView android:id="@+id/codecLabel" style="@style/RowLabel" android:text="Codec" />

        <RadioGroup
            android:id="@+id/codec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/codecH264"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="H.264" />

            <RadioButton
                android:id="@+id/codecH265"
                style="@style/Chip"
                android:text="H.265" />
        </RadioGroup>

        <!-- ── quality: compressed only ───────────────────────────────── -->
        <TextView android:id="@+id/qualityLabel" style="@style/RowLabel" android:text="Quality" />

        <RadioGroup
            android:id="@+id/quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/qualityLow"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="Low" />

            <RadioButton
                android:id="@+id/qualityMedium"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="Medium" />

            <RadioButton
                android:id="@+id/qualityHigh"
                style="@style/Chip"
                android:text="High" />
        </RadioGroup>

        <!-- ── size cap on the LONG edge; the short one follows the screen ── -->
        <TextView style="@style/RowLabel" android:text="Long edge, at most" />

        <RadioGroup
            android:id="@+id/cap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/cap720"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="720" />

            <RadioButton
                android:id="@+id/cap1280"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="1280" />

            <RadioButton
                android:id="@+id/cap1920"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="1920" />

            <RadioButton
                android:id="@+id/cap2560"
                style="@style/Chip"
                android:text="2560" />
        </RadioGroup>

        <!-- ── frame rate ─────────────────────────────────────────────── -->
        <TextView style="@style/RowLabel" android:text="Frames a second" />

        <RadioGroup
            android:id="@+id/fps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/fps15"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="15" />

            <RadioButton
                android:id="@+id/fps24"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="24" />

            <RadioButton
                android:id="@+id/fps30"
                style="@style/Chip"
                android:layout_marginEnd="8dp"
                android:text="30" />

            <RadioButton
                android:id="@+id/fps60"
                style="@style/Chip"
                android:text="60" />
        </RadioGroup>

        <!-- ── what the choices above will cost ───────────────────────── -->
        <TextView
            android:id="@+id/estimate"
            style="@style/Readout"
            android:layout_marginBottom="18dp"
            android:textColor="@color/amber" />

        <!-- ── the one key, and it says what the next press does (§5) ──── -->
        <TextView
            android:id="@+id/share"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/share_button"
            android:text="START"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <!-- ── the state panel: what the app believes, always on screen ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/panel"
            android:padding="12dp">

            <TextView android:id="@+id/stateLine" style="@style/Readout" />

            <TextView
                android:id="@+id/sizeLine"
                style="@style/Readout"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/rateLine"
                style="@style/Readout"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/watchersLine"
                style="@style/Readout"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/addressLine"
                style="@style/Readout"
                android:layout_marginTop="4dp"
                android:textColor="@color/sand_dim" />

            <TextView
                android:id="@+id/faultLine"
                style="@style/Readout"
                android:layout_marginTop="4dp"
                android:textColor="@color/red" />
        </LinearLayout>

        <!-- ── the trace, live, newest at the bottom ──────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/RowLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Trace" />

            <TextView
                android:id="@+id/exportTrace"
                style="@style/Chip"
                android:text="Export" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/traceScroll"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/panel"
            android:padding="8dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/trace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/sand_dim"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
